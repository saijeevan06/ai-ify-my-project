# ── AI ─────────────────────────────────────────────────────────────
# Optional. Without a key the app uses the built-in 26-pattern generator.
ANTHROPIC_API_KEY=
# Model used for project upgrades (structured JSON output).
AI_MODEL=claude-opus-5-5
# Hard ceiling for one generation before falling back to patterns (ms).
AI_TIMEOUT_MS=15000

# ── Server ─────────────────────────────────────────────────────────
PORT=8787
# Public origin used in referral + share links (no trailing slash).
PUBLIC_URL=http://localhost:5173
# JSON database location (created on first run).
DATA_DIR=./data
# Salt for hashing IPs (abuse checks). Change in production.
IP_SALT=change-me

# ── Growth / demo ──────────────────────────────────────────────────
# Key for /admin analytics.
ADMIN_KEY=aiify-admin
# Seed the campus leaderboard with sample colleges (good for demos; set false for launch).
SEED_LEADERBOARD=true
# Enables /api/demo/* (simulated referrals). Never enable in production.
DEMO_MODE=true
